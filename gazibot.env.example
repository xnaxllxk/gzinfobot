# Скопировать в /etc/gazibot.env и выставить права: sudo chmod 600 /etc/gazibot.env
# Здесь только секреты и ID админа: из Telegram их менять нельзя (так и задумано).
TELEGRAM_TOKEN=123456:ABC...

# Кто может менять настройки из чата: ваш Telegram user ID (узнать: бот @userinfobot).
# Команды принимаются только от этого ID, даже если написать их в общей группе.
ADMIN_USER_ID=123456789

# Ключ локального шлюза: то же значение, что FREELLMPOOL_PROXY_KEY в /etc/freellmpool.env.
# Сгенерировать: openssl rand -hex 32
AI_API_KEY=сюда_случайная_строка

# Необязательно:
# ADMIN_CHAT_ID=123456789       # куда слать уведомления о сбоях (по умолчанию = ADMIN_USER_ID)
# AI_MODEL=auto                 # auto | fast | quality | fair | agent (псевдонимы freellmpool) или provider/model
#   auto — шлюз сам делит запросы между всеми доступными маршрутами (с переключением при сбоях).
#   Закрепить именно DeepSeek: AI_MODEL=orcarouter/deepseek/deepseek-v4-flash-free
#   (тогда переключения на другие провайдеры НЕТ: при сбое OrcaRouter бот получит ошибку и повторит позже)
# AI_URL=http://127.0.0.1:8080/v1/chat/completions
#   AI_URL менять из чата нельзя: туда уходит ключ. http допускается только для 127.0.0.1/localhost,
#   для любого другого адреса бот потребует https и не запустится с открытым http.
# AI_JSON_MODE=1                # просить строгий JSON; нужно только после `freellmpool conformance run`
#                               # (иначе freellmpool отвечает 503: он не знает, кто из провайдеров это умеет)

# Старые переменные (REFRESH_TIMES, ZIRAAT_URL, ZIRAAT_CHANNEL, FUEL_URL) нужны только при самом
# первом запуске: из них создаётся settings.json. DEEPSEEK_* больше не используются — удалите.

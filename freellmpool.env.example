# Скопировать в /etc/freellmpool.env и выставить права: sudo chmod 600 /etc/freellmpool.env
# Без единого ключа шлюз работает на беcключевых провайдерах (Pollinations, OVHcloud, Kilo):
# они бесплатны, но нестабильны и могут логировать запросы. Для надёжности добавьте 2–3 ключа.

# Пароль к самому шлюзу (тот же, что AI_API_KEY в /etc/gazibot.env). Сгенерировать: openssl rand -hex 32
FREELLMPOOL_PROXY_KEY=сюда_случайная_строка

# Бесплатные ключи провайдеров (все необязательны, чем больше — тем надёжнее):
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
ORCAROUTER_API_KEY=...   # бесплатный DeepSeek V4 Flash (см. providers.toml)
# MISTRAL_API_KEY=...
